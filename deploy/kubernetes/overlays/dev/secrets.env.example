# Copy to secrets.env (gitignored) and fill in. Never commit secrets.env.
#   cp secrets.env.example secrets.env
#
# Generate ENCRYPTION_KEY and ADMIN_TOKEN with:
#   docker run --rm warden:k8s keygen
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64
ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
# The password below must match the one in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_DEV_PASSWORD
DATABASE_URL=postgres://warden:CHANGE_ME_DEV_PASSWORD@postgres:5432/warden?sslmode=disable
REDIS_URL=redis://redis:6379/0
