# Copy to secrets.env (gitignored). In a real cluster prefer External Secrets
# or Sealed Secrets (docs/kubernetes.md) and drop the secretGenerator.
# Generate the first two with: docker run --rm <image> keygen
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64
ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
DATABASE_URL=postgres://warden:CHANGE_ME@db.example.internal:5432/warden?sslmode=verify-full
REDIS_URL=rediss://:CHANGE_ME@redis.example.internal:6380/0
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Only if the grpc component is enabled (comma separated, 32+ chars each):
# GRPC_API_KEYS=CHANGE_ME
# Optional, if you use them:
# RABBITMQ_URL=amqps://user:CHANGE_ME@mq.example.internal:5671/
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# SENTRY_DSN=CHANGE_ME
