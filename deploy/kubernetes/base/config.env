# Non-secret configuration for every environment. Full list: .env.example
APP_ENV=production
SERVICE_NAME=warden
LOG_LEVEL=info
LOG_FORMAT=json

HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_COOKIE_SECURE=true
HTTP_COOKIE_SAME_SITE=Lax
HTTP_PROXY_HEADER=X-Forwarded-For
HTTP_CORS_ALLOWED_ORIGINS=

ADMIN_ADDR=:9090

GRPC_ENABLED=false

# Migrations run in an initContainer (warden migrate), not in every pod.
DATABASE_AUTO_MIGRATE=false
DATABASE_MAX_CONNS=20

S3_ENABLED=false
SMTP_TLS_POLICY=mandatory

# Argon2 uses 19 MiB per hash; two at a time per pod fits the 512Mi limit.
PASSWORD_MAX_CONCURRENT_HASHES=2

# Go runtime: about 90 percent of the container memory limit (512Mi).
GOMEMLIMIT=460MiB
