        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(warden_password_hash_wait_seconds_bucket[5m])))",
          "legendFormat": "queue wait p95"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Deliveries (emails, events, webhooks)",
