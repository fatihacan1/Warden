        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(process_resident_memory_bytes{job=\"warden\"})",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "sum(go_memstats_heap_inuse_bytes{job=\"warden\"})",
          "legendFormat": "heap in use"
